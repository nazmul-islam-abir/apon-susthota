# Supabase project credentials — copy this to .env and fill in.
# Get these from Supabase Dashboard → Project Settings → API.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Groq API key — used by the AI chat screen (lib/services/groq_router.dart).
# Get this from https://console.groq.com/keys.
# For multi-key rotation, supply several comma-separated values in
# GROQ_API_KEYS instead — the router will use the first non-empty one.
# DO NOT commit a real key. Rotate after sharing in chat / screenshots.
GROQ_API_KEY=
GROQ_API_KEYS=
